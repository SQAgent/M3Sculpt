# Copy this file to .env and replace placeholders for your existing services.
# Never put real credentials in .env.example. The application loads .env through
# python-dotenv; environment variables already exported by the shell take priority.

# Application mode: test reads stored properties; normal performs live computation.
M3SCULPTOR_MODE=test
M3SCULPTOR_HOST=127.0.0.1
M3SCULPTOR_STRICT_ORIGIN=0
M3SCULPTOR_ALLOW_ORIGIN=
# START.sh reads this from the shell before Python loads .env. Export it separately
# when using a conda environment other than the default m3s environment.
# M3SCULPTOR_CONDA_ENV=m3s

# Chat backend: opencode (default) or http.
# opencode must be installed and configured with a working provider/model.
M3S_CHAT_BACKEND=opencode
M3S_OPENCODE_BIN=opencode
M3S_OPENCODE_MODEL=your-provider/your-model
M3S_OPENCODE_AGENT=
M3S_OPENCODE_WORKDIR=/tmp/m3s_opencode_run

# Alternative HTTP chat backend: set M3S_CHAT_BACKEND=http to use these settings.
# URLs are API base URLs, ending in /v1; do not append /chat/completions.
VLM_MODEL=your-chat-model
VLM_API_KEY=replace-with-your-chat-api-key
VLM_URL=http://127.0.0.1:8000/v1
# Optional fallback names, used when the corresponding VLM_* value is empty:
# RETRIEVAL_LLM_MODEL=your-chat-model
# RETRIEVAL_LLM_API_KEY=replace-with-your-chat-api-key
# RETRIEVAL_LLM_URL=http://127.0.0.1:8000/v1
# Optional HTTP-only generation settings:
# M3S_CHAT_MAX_TOKENS=2048
# M3S_CHAT_ENABLE_THINKING=false

# Embeddings always use an HTTP endpoint, including with opencode chat.
# Use the same embedding model and vector dimension as the existing Milvus corpus.
# Do not append /embeddings to EMBED_URL.
EMBED_MODEL=your-corpus-embedding-model
EMBED_API_KEY=replace-with-your-embedding-api-key
EMBED_URL=http://127.0.0.1:8001/v1

# Existing paper knowledge graph. Replace the example credentials.
NEO4J_URL=bolt://127.0.0.1:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=replace-with-your-neo4j-password
NEO4J_DATABASE=neo4j

# Existing MongoDB data. Add authentication to the URI when required.
# Example authenticated URI:
# MONGO_URL=mongodb://your-user:your-password@127.0.0.1:27017/?authSource=admin
MONGO_URL=mongodb://127.0.0.1:27017
MONGO_DATABASE=MechanicalMetamaterialProjectDatabase
MONGO_PERFORMANCE_DATABASE=MechanicalMetamaterialProjectDatabase
MONGO_PERFORMANCE_DESIGN_SPACE=DS3d_6

# Existing Milvus database, containing the entity collection used for paper search.
MILVUS_URL=http://127.0.0.1:19530
MILVUS_USERNAME=root
MILVUS_PASSWORD=replace-with-your-milvus-password
MILVUS_DATABASE=default

# Normal mode only: image editing and local Hunyuan3D reconstruction.
AL_API_KEY=replace-with-your-image-editing-api-key
HUNYUAN_URL=http://127.0.0.1:7860/generate
M3S_WORKDIR=output/doi_runs

# Python periodic FEM is the default. Defaults remain E=1 GPa, v=0.3,
# resolution=64 and orthorhombic symmetry; there are no environment variables
# or HTTP configuration fields for overriding resolution or symmetry.
M3S_HOMOGENIZATION_BACKEND=python
# Optional GPU solver: set the backend to chfem and use its installed environment.
CHFEM_CONDA_ENV=chfem
CHFEM_CONDA_TIMEOUT=3600
